import turtle
import random

turtle.colormode(255)
t= turtle.Turtle()
s= turtle.Screen()
t.shape("triangle")
t.penup()
t.left(90)
t.backward(250)
pen = turtle.Turtle()
pen.penup()
pen.goto(-280,250)



def right():
    t.setx(t.xcor()+10)

def left():
    t.setx(t.xcor()-10)

s.listen()
s.onkey(right, "Right")
s.onkey(left, "Left")

balloon= turtle.Turtle()
balloon.penup()
balloon.shape("circle")
balloon.goto(random.randint(-250,250),275)

balloon.right(90)
count = 0
while True:
    balloon.forward(3)
    if balloon.distance(t) <15:
        balloon.hideturtle()
        balloon.goto(random.randint(-250,250),275)
        balloon.color(random.randint(0,255),random.randint(0,255),random.randint(0,255))
        balloon.showturtle()
        count = count + 1
        pen.clear()
        pen.write(count,font=("arial",25,"bold"))
    else:
        if balloon.ycor()<-280:
            balloon.hideturtle()
            balloon.goto(random.randint(-250,250),275)
            balloon.color(random.randint(0,255),random.randint(0,255),random.randint(0,255))
            balloon.showturtle()
            count = count -1
            pen.clear()
            pen.write(count,font=("arial",25,"bold"))


s. mainloop()